{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (vcpkg, tests)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LIVESPLIT_BRIDGE_BUILD_TESTS": "ON",
        "LIVESPLIT_BRIDGE_BUILD_CLI": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (vcpkg, tests)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LIVESPLIT_BRIDGE_BUILD_TESTS": "ON",
        "LIVESPLIT_BRIDGE_BUILD_CLI": "ON"
      }
    },
    {
      "name": "user",
      "inherits": "base",
      "displayName": "Release library only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_MANIFEST_FEATURES": "",
        "LIVESPLIT_BRIDGE_BUILD_TESTS": "OFF",
        "LIVESPLIT_BRIDGE_BUILD_CLI": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "user",
      "configurePreset": "user"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
