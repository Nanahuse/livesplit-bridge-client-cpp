{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RpcResponse",
  "oneOf": [
    {
      "$ref": "#/$defs/TimerStateResponse"
    },
    {
      "$ref": "#/$defs/RunStateResponse"
    },
    {
      "$ref": "#/$defs/RunIconsResponse"
    },
    {
      "$ref": "#/$defs/AttemptStateResponse"
    },
    {
      "$ref": "#/$defs/ContextStateResponse"
    },
    {
      "$ref": "#/$defs/CompletedCountResponse"
    },
    {
      "$ref": "#/$defs/ControlSuccessResponse"
    },
    {
      "$ref": "#/$defs/ErrorResponse"
    }
  ],
  "$defs": {
    "AttemptSegment": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "split_time": {
          "$ref": "#/$defs/TimeValue"
        },
        "custom_variables": {
          "$ref": "#/$defs/DictionaryOfStringAndString"
        }
      },
      "required": [
        "index",
        "split_time",
        "custom_variables"
      ],
      "additionalProperties": false
    },
    "AttemptState": {
      "type": "object",
      "properties": {
        "attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "segments": {
          "$ref": "#/$defs/ListOfAttemptSegment"
        }
      },
      "required": [
        "attempt_count",
        "segments"
      ],
      "additionalProperties": false
    },
    "AttemptStateResponse": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "result": {
          "$ref": "#/$defs/AttemptState"
        }
      },
      "required": [
        "request_id",
        "session_id",
        "result"
      ],
      "additionalProperties": false
    },
    "BridgeError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/BridgeErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "BridgeErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "invalid_argument",
        "operation_failed",
        "internal_error",
        "permission_denied"
      ]
    },
    "ComparisonTime": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/TimeValue"
        }
      },
      "required": [
        "name",
        "time"
      ],
      "additionalProperties": false
    },
    "CompletedCount": {
      "type": "object",
      "properties": {
        "completed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "completed_count"
      ],
      "additionalProperties": false
    },
    "CompletedCountResponse": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "result": {
          "$ref": "#/$defs/CompletedCount"
        }
      },
      "required": [
        "request_id",
        "session_id",
        "result"
      ],
      "additionalProperties": false
    },
    "ContextState": {
      "type": "object",
      "properties": {
        "current_timing_method": {
          "$ref": "#/$defs/TimingMethod"
        },
        "current_comparison": {
          "type": "string"
        },
        "custom_variables": {
          "$ref": "#/$defs/DictionaryOfStringAndString"
        }
      },
      "required": [
        "current_timing_method",
        "current_comparison",
        "custom_variables"
      ],
      "additionalProperties": false
    },
    "ContextStateResponse": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "result": {
          "$ref": "#/$defs/ContextState"
        }
      },
      "required": [
        "request_id",
        "session_id",
        "result"
      ],
      "additionalProperties": false
    },
    "ControlSuccessResponse": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "result": {
          "const": null
        }
      },
      "required": [
        "request_id",
        "session_id",
        "result"
      ],
      "additionalProperties": false
    },
    "DictionaryOfStringAndString": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "error": {
          "$ref": "#/$defs/BridgeError"
        }
      },
      "required": [
        "request_id",
        "session_id",
        "error"
      ],
      "additionalProperties": false
    },
    "ListOfAttemptSegment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AttemptSegment"
      }
    },
    "ListOfComparisonTime": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ComparisonTime"
      }
    },
    "ListOfSegmentInfo": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SegmentInfo"
      }
    },
    "ListOfString": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "RunIcons": {
      "type": "object",
      "properties": {
        "game_icon": {
          "type": [
            "null",
            "string"
          ],
          "description": "Base64-encoded PNG image; null when absent."
        },
        "segment_icons": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": "Segment icons in Run order, as Base64-encoded PNG images; null entries when absent."
        }
      },
      "required": [
        "game_icon",
        "segment_icons"
      ],
      "if": {
        "properties": {
          "segment_icons": {
            "const": null
          }
        },
        "required": [
          "segment_icons"
        ]
      },
      "then": {
        "properties": {
          "segment_icons": {
            "$ref": "#/$defs/ListOfString"
          }
        }
      },
      "additionalProperties": false
    },
    "RunIconsResponse": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "result": {
          "$ref": "#/$defs/RunIcons"
        }
      },
      "required": [
        "request_id",
        "session_id",
        "result"
      ],
      "additionalProperties": false
    },
    "RunMetadata": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": [
            "null",
            "string"
          ]
        },
        "platform_name": {
          "type": [
            "null",
            "string"
          ]
        },
        "region_name": {
          "type": [
            "null",
            "string"
          ]
        },
        "uses_emulator": {
          "type": "boolean"
        },
        "variables": {
          "$ref": "#/$defs/DictionaryOfStringAndString"
        }
      },
      "required": [
        "run_id",
        "platform_name",
        "region_name",
        "uses_emulator",
        "variables"
      ],
      "additionalProperties": false
    },
    "RunState": {
      "type": "object",
      "properties": {
        "game_name": {
          "type": "string"
        },
        "category_name": {
          "type": "string"
        },
        "offset_ticks": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "file_path": {
          "type": [
            "null",
            "string"
          ]
        },
        "layout_path": {
          "type": [
            "null",
            "string"
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparisons": {
          "$ref": "#/$defs/ListOfString"
        },
        "segments": {
          "$ref": "#/$defs/ListOfSegmentInfo"
        }
      },
      "required": [
        "game_name",
        "category_name",
        "offset_ticks",
        "file_path",
        "layout_path",
        "metadata",
        "comparisons",
        "segments"
      ],
      "additionalProperties": false
    },
    "RunStateResponse": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "result": {
          "$ref": "#/$defs/RunState"
        }
      },
      "required": [
        "request_id",
        "session_id",
        "result"
      ],
      "additionalProperties": false
    },
    "SegmentInfo": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "type": "string"
        },
        "comparisons": {
          "$ref": "#/$defs/ListOfComparisonTime"
        },
        "best_segment_time": {
          "$ref": "#/$defs/TimeValue"
        }
      },
      "required": [
        "index",
        "name",
        "comparisons",
        "best_segment_time"
      ],
      "additionalProperties": false
    },
    "TimeValue": {
      "type": "object",
      "properties": {
        "real_time_ticks": {
          "type": [
            "null",
            "integer"
          ],
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "game_time_ticks": {
          "type": [
            "null",
            "integer"
          ],
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "real_time_ticks",
        "game_time_ticks"
      ],
      "additionalProperties": false
    },
    "TimerPhase": {
      "type": "string",
      "enum": [
        "unspecified",
        "not_running",
        "running",
        "paused",
        "ended"
      ]
    },
    "TimerState": {
      "type": "object",
      "properties": {
        "phase": {
          "$ref": "#/$defs/TimerPhase"
        },
        "split_index": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "real_time_ticks": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "game_time_ticks": {
          "type": [
            "null",
            "integer"
          ],
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "is_game_time_initialized": {
          "type": "boolean"
        },
        "is_game_time_paused": {
          "type": "boolean"
        }
      },
      "required": [
        "phase",
        "split_index",
        "real_time_ticks",
        "game_time_ticks",
        "is_game_time_initialized",
        "is_game_time_paused"
      ],
      "additionalProperties": false
    },
    "TimerStateResponse": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "result": {
          "$ref": "#/$defs/TimerState"
        }
      },
      "required": [
        "request_id",
        "session_id",
        "result"
      ],
      "additionalProperties": false
    },
    "TimingMethod": {
      "type": "string",
      "enum": [
        "unspecified",
        "real_time",
        "game_time"
      ]
    }
  }
}
