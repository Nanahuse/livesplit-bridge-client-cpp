{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BridgeEvent",
  "oneOf": [
    {
      "$ref": "#/$defs/TimerEvent"
    },
    {
      "$ref": "#/$defs/ResetEvent"
    },
    {
      "$ref": "#/$defs/ChangedEvent"
    }
  ],
  "$defs": {
    "ChangedEvent": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "type": {
          "$ref": "#/$defs/ChangedEventType"
        },
        "timer_state": {
          "const": null
        }
      },
      "required": [
        "session_id",
        "event_sequence",
        "type",
        "timer_state"
      ],
      "additionalProperties": false
    },
    "ChangedEventType": {
      "type": "string",
      "enum": [
        "run_changed",
        "context_changed"
      ]
    },
    "ResetEvent": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "type": {
          "type": "string",
          "const": "timer_reset"
        },
        "timer_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimerState"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "event_sequence",
        "type",
        "timer_state"
      ],
      "additionalProperties": false
    },
    "TimerEvent": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "type": {
          "$ref": "#/$defs/TimerEventType"
        },
        "timer_state": {
          "$ref": "#/$defs/TimerState"
        }
      },
      "required": [
        "session_id",
        "event_sequence",
        "type",
        "timer_state"
      ],
      "additionalProperties": false
    },
    "TimerEventType": {
      "type": "string",
      "enum": [
        "timer_started",
        "timer_split",
        "timer_skipped",
        "timer_undo",
        "timer_phase_changed"
      ]
    },
    "TimerPhase": {
      "type": "string",
      "enum": [
        "unspecified",
        "not_running",
        "running",
        "paused",
        "ended"
      ]
    },
    "TimerState": {
      "type": "object",
      "properties": {
        "phase": {
          "$ref": "#/$defs/TimerPhase"
        },
        "split_index": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "real_time_ticks": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "game_time_ticks": {
          "type": [
            "null",
            "integer"
          ],
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "is_game_time_initialized": {
          "type": "boolean"
        },
        "is_game_time_paused": {
          "type": "boolean"
        }
      },
      "required": [
        "phase",
        "split_index",
        "real_time_ticks",
        "game_time_ticks",
        "is_game_time_initialized",
        "is_game_time_paused"
      ],
      "additionalProperties": false
    }
  }
}
